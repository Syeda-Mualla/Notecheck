# Browser-visible Supabase project URL and anon/publishable key (not the service role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
PROFILE_SESSION_SECRET=
# Initial passcodes for newly created fictional profiles. Choose your own 4–8 digits.
PROFILE_PIN_ALEX=4821
PROFILE_PIN_MAYA=5932
PROFILE_PIN_JORDAN=6743
# Hosted Gemini API.
LLM_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
# Web OAuth client ID for the optional Drive export permission popup.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
